{
  "expo": {
    "name": "Phoenix Rise",
    "slug": "phoenix-rise",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "phoenixrise",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
